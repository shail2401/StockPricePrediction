        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "def train_test_split_linear_regression(df):\n",
        "    X = df[['Open']].values\n",
        "    y = df[['Close']].values\n",
        "    return train_test_split(X, y, test_size=0.3, shuffle=False), (y.min(), y.max())\n"
